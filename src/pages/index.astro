---
import Layout from '../layouts/Layout.astro';
import RandomQuestion from "../components/RandomQuestion.jsx";
---

<Layout title="Icebreaker Questions">
  <div class="min-h-screen">
    <header class="absolute top-0 right-0 p-4">
      <a 
        href="/why-icebreakers" 
        class="inline-block px-4 py-2 text-[#191970] hover:text-[#FF8B7B] transition-colors"
        style="font-family: 'Outfit', sans-serif;"
      >
        Why Icebreakers Matter?
      </a>
    </header>
    <RandomQuestion client:load />
  </div>
</Layout>
