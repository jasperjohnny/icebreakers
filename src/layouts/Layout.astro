---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Icebreaker questions for building stronger teams" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600&family=Satisfy&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="min-h-screen">
      {currentPath !== '/' && (
        <header class="absolute top-0 left-0 right-0 p-4 flex justify-between items-center">
          <a 
            href="/" 
            class="inline-block px-4 py-2 text-[#191970] hover:text-[#FF8B7B] transition-colors"
            style="font-family: 'Outfit', sans-serif;"
          >
            ← Back to Questions
          </a>
        </header>
      )}
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --accent: #FF8B7B;
    --accent-dark: #FF7B6B;
  }
  html {
    font-family: 'Outfit', system-ui, sans-serif;
    background: #fff;
    color: #191970;
  }
</style>
